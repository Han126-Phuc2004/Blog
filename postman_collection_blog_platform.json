    {
      "name": "Create Role",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roleName\": \"ROLE_USER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/roles",
          "host": ["{{baseUrl}}"],
          "path": ["api","roles"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var json = {};",
              "try { json = pm.response.json(); } catch(e) {}",
              "pm.test('Status is 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
              "if (json.roleId) pm.environment.set('roleId', json.roleId);",
              "else if (json.id) pm.environment.set('roleId', json.id);",
              "else pm.environment.unset('roleId');",
              "console.log('roleId ->', pm.environment.get('roleId'))"
            ]
          }
        }
      ]
    },
    {
      "name": "Create User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"secret\",\n  \"email\": \"alice@example.com\",\n  \"fullName\": \"Alice Nguyen\",\n  \"role\": { \"roleId\": 1 }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": ["{{baseUrl}}"],
          "path": ["api","users"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Build request body dynamically from environment variables to avoid invalid JSON if variables are empty",
              "var roleId = pm.environment.get('roleId');",
              "if (!roleId) {",
              "    throw new Error('roleId is not set. Run Create Role first.');",
              "}",
              "var body = {",
              "    username: 'alice',",
              "    password: 'secret',",
              "    email: 'alice@example.com',",
              "    fullName: 'Alice Nguyen',",
              "    role: { roleId: Number(roleId) }",
              "};",
              "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
              "pm.request.body.update(JSON.stringify(body));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var json = {};",
              "try { json = pm.response.json(); } catch(e) {}",
              "pm.test('Status is 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
              "if (json.userId) pm.environment.set('userId', json.userId);",
              "else if (json.id) pm.environment.set('userId', json.id);",
              "else if (json.user && json.user.userId) pm.environment.set('userId', json.user.userId);",
              "console.log('userId ->', pm.environment.get('userId'))"
            ]
          }
        }
      ]
    },
