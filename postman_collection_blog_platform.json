          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var postId = pm.environment.get('postId');",
              "var userId = pm.environment.get('userId');",
              "if (!postId) {",
              "    throw new Error('postId is not set. Run Create Post first.');",
              "}",
              "if (!userId) {",
              "    throw new Error('userId is not set. Run Create User first.');",
              "}",
              "var body = {",
              "    content: 'Nice post!',",
              "    post: { postId: Number(postId) },",
              "    author: { userId: Number(userId) }",
              "};",
              "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
              "pm.request.body.update(JSON.stringify(body));"
            ]
