{
  "info": {
    "name": "Blog Platform API - Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "blog-platform-collection"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api","auth","login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = {};",
                  "try { json = pm.response.json(); } catch(e) {}",
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('Response has token', function () { pm.expect(json.token).to.exist; });",
                  "pm.test('User is admin', function () { pm.expect(json.role).to.equal('ADMIN'); });",
                  "if (json.token) {",
                  "    pm.environment.set('authToken', json.token);",
                  "    console.log('Token saved:', json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "GET",
            "header": [
              { 
                "key": "Authorization", 
                "value": "Bearer {{authToken}}",
                "description": "JWT Token from login"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api","auth","validate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.test('Token is valid', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
