{
	"info": {
		"_postman_id": "blog-api-collection-complete",
		"name": "Blog Platform API - Complete (JWT + REST)",
		"description": "Complete API collection for Blog Platform with JWT Authentication\n\n✅ Features:\n- JWT Authentication\n- Posts API (CRUD)\n- Users API (CRUD)\n- Roles API (CRUD)\n- Comments API (CRUD)\n\n📝 Workflow:\n1. Login to get JWT token (auto-saved to {{jwt_token}})\n2. Use token for protected endpoints\n3. Test all CRUD operations\n\n🔐 Security:\n- Public: Posts (view), Comments (create, view)\n- Admin Only: Users, Roles, Post/Comment management",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "1. Authentication (JWT)",
			"item": [
				{
					"name": "Login (Get JWT Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Auto-save JWT token to environment variable",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.environment.set(\"jwt_token\", jsonData.token);",
									"        console.log(\"✅ JWT token saved to environment:\", jsonData.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "🔐 Login để nhận JWT token.\n\n✅ Response:\n- token: JWT token string\n- username: Tên user\n- role: Role của user\n\n💡 Token sẽ tự động được lưu vào {{jwt_token}} variable"
					},
					"response": []
				},
				{
					"name": "Validate Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/validate",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "validate"]
						},
						"description": "✅ Kiểm tra JWT token có hợp lệ không.\n\n🔑 Cần header:\nAuthorization: Bearer <token>"
					},
					"response": []
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "me"]
						},
						"description": "👤 Lấy thông tin user hiện tại.\n\n🔑 Cần JWT token trong Authorization header."
					},
					"response": []
				},
				{
					"name": "Check Auth Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/check",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "check"]
						},
						"description": "✅ Kiểm tra authentication status.\n\n🌐 Public endpoint nhưng có thể gửi token để check."
					},
					"response": []
				},
				{
					"name": "Public Endpoint (No Auth)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/public",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "public"]
						},
						"description": "🌐 Public endpoint - Không cần authentication.\n\n✅ Test endpoint public access."
					},
					"response": []
				},
				{
					"name": "Admin Only Endpoint (Test)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/admin-only",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "admin-only"]
						},
						"description": "🔒 Admin only endpoint.\n\n🔑 Cần JWT token với role ADMIN."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "logout"]
						},
						"description": "👋 Logout.\n\n💡 Note: Với JWT, client chỉ cần xóa token. Server không track sessions."
					},
					"response": []
				}
			],
			"description": "🔐 JWT Authentication endpoints - Login, validate token, check auth status"
		},
