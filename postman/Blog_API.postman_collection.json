							"raw": "{\n  \"title\": \"Bài viết đã được cập nhật\",\n  \"content\": \"Nội dung đã được cập nhật từ Postman\",\n  \"thumbnailUrl\": \"https://picsum.photos/800/600?updated\"\n}"
