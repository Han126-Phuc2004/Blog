						"description": "Public endpoint để test - không cần authentication"
					},
					"response": []
				},
				{
					"name": "Admin Only Endpoint",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/admin-only",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "admin-only"]
						},
						"description": "Admin only endpoint - cần login với role ADMIN"
