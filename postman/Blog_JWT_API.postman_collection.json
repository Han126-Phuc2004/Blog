              }
            ],
            "url": {
              "raw": "{{base_url}}/api/roles/1",
              "host": ["{{base_url}}"],
              "path": ["api", "roles", "1"]
            },
            "description": "Lấy role theo ID.\n\nCần: JWT token với role ADMIN"
          },
          "response": []
        }
      ],
      "description": "Role management endpoints - Chỉ ADMIN mới có quyền truy cập"
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ]
}

