{
  "info": {
    "name": "Blog API - JWT Authentication",
    "_postman_id": "jwt-blog-api-2024",
    "description": "Complete JWT Authentication API collection for Blog Platform\n\nWorkflow:\n1. Login to get JWT token\n2. Copy token to Authorization header for protected endpoints\n3. Test various endpoints with JWT\n\nTip: Use {{jwt_token}} variable to auto-fill token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Get JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-save JWT token to environment variable",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.environment.set(\"jwt_token\", jsonData.token);",
                  "        console.log(\"JWT token saved to environment:\", jsonData.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login để nhận JWT token.\n\nResponse sẽ chứa:\n- token: JWT token string\n- user: Thông tin user\n\nToken sẽ tự động được save vào environment variable {{jwt_token}}"
          },
          "response": []
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "validate"]
            },
            "description": "Kiểm tra JWT token có hợp lệ không.\n\nCần header:\nAuthorization: Bearer <token>"
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Lấy thông tin user hiện tại.\n\nCần JWT token trong Authorization header."
          },
          "response": []
        },
        {
          "name": "Check Auth Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/check",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "check"]
            },
            "description": "Kiểm tra authentication status.\n\nPublic endpoint nhưng có thể gửi token để check."
          },
          "response": []
        },
        {
          "name": "Admin Only Endpoint (Test)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/admin-only",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "admin-only"]
            },
            "description": "Test endpoint chỉ dành cho ADMIN.\n\nCần JWT token với role ADMIN."
          },
          "response": []
        },
        {
          "name": "Public Endpoint (No Auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/public",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "public"]
            },
            "description": "Public endpoint - Không cần authentication."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Logout.\n\nNote: Với JWT, client chỉ cần xóa token. Server không track sessions."
          },
          "response": []
        }
      ],
      "description": "JWT Authentication endpoints"
    },
    {
      "name": "2. Users (Admin Only)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "users"]
            },
            "description": "Lấy danh sách tất cả users.\n\nCần: JWT token với role ADMIN"
          },
          "response": []
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/1",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "1"]
            },
            "description": "Lấy thông tin user theo ID.\n\nCần: JWT token với role ADMIN"
          },
          "response": []
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"test123\",\n  \"email\": \"test@example.com\",\n  \"fullName\": \"Test User\",\n  \"role\": {\n    \"roleId\": 2\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "users"]
            },
            "description": "Tạo user mới.\n\nCần: JWT token với role ADMIN"
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser_updated\",\n  \"email\": \"updated@example.com\",\n  \"fullName\": \"Test User Updated\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/1",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "1"]
            },
            "description": "Update user.\n\nCần: JWT token với role ADMIN"
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/1",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "1"]
            },
            "description": "Xóa user.\n\nCần: JWT token với role ADMIN"
          },
          "response": []
        }
      ],
      "description": "User management endpoints - Chỉ ADMIN mới có quyền truy cập"
    },
    {
      "name": "3. Posts (Public)",
      "item": [
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/posts",
              "host": ["{{base_url}}"],
              "path": ["api", "posts"]
            },
            "description": "Lấy tất cả posts.\n\nPublic endpoint - Không cần authentication."
          },
          "response": []
        },
        {
          "name": "Get Post by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/posts/1",
              "host": ["{{base_url}}"],
              "path": ["api", "posts", "1"]
            },
            "description": "Lấy chi tiết post theo ID.\n\nPublic endpoint - Không cần authentication."
          },
          "response": []
        }
      ],
      "description": "Public post endpoints - Không cần authentication"
    },
    {
      "name": "4. Roles (Admin Only)",
      "item": [
        {
          "name": "Get All Roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/roles",
              "host": ["{{base_url}}"],
              "path": ["api", "roles"]
            },
            "description": "Lấy tất cả roles.\n\nCần: JWT token với role ADMIN"
          },
          "response": []
        },
        {
          "name": "Get Role by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
